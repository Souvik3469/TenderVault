generator client {
    provider = "prisma-client-js"
    // binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
    provider = "mongodb"
    url      = env("DATABASE_URL")
}

model User {
    id               String         @id @default(auto()) @map("_id") @db.ObjectId
    name             String?
    email            String?        @unique
    role             String?        @default("vendor") // vendor | company | admin
    bio              String?
    image            String?
    coverImage       String?
    profileImage     String?
    password         String?
    document         String?
    hasNotification  Boolean?
    boughtTenders    Tender[]       @relation("boughtTenders")
    ownedTenders     Tender[]       @relation("ownedTenders")
    evaluatedTenders Tender[]       @relation("evaluatedTenders")
    notifications    Notification[]
    questions        Question[]
    answers          Answer[]
    bidAsCompany     Bid[]          @relation("company")
    bidAsVendor      Bid[]          @relation("vendor")
    createdAt        DateTime       @default(now())
    updatedAt        DateTime       @updatedAt
}

model Bid {
    id         String   @id @default(auto()) @map("_id") @db.ObjectId
    tender     Tender   @relation(fields: [tenderId], references: [id], onDelete: Cascade)
    company    User     @relation("company", fields: [companyId], references: [id], onDelete: Cascade)
    vendor     User     @relation("vendor", fields: [vendorId], references: [id], onDelete: Cascade)
    tenderId   String   @db.ObjectId
    companyId  String   @db.ObjectId
    vendorId   String   @db.ObjectId
    status     String   // pending | accepted | rejected | withdrawn
    amount     Float
    message    String?  // vendor's proposal / cover letter
    vendorName String?
    location   String?
    createdAt  DateTime @default(now())
    updatedAt  DateTime @updatedAt
}

model Tender {
    id          String     @id @default(auto()) @map("_id") @db.ObjectId
    title       String
    description String?
    category    String
    cost        Float      // minimum acceptable bid amount
    deadline    DateTime?  // bid submission deadline
    status      String?    @default("draft") // draft | open | closed | awarded | cancelled
    rating      Int?       // admin quality score 1–5
    imageUrl    String?
    companyName String?
    companyId   String     @db.ObjectId
    owner       User       @relation("ownedTenders", fields: [companyId], references: [id], onDelete: Cascade)
    evaluatorId String?    @db.ObjectId
    evaluator   User?      @relation("evaluatedTenders", fields: [evaluatorId], references: [id], onDelete: Cascade)
    buyerId     String?    @db.ObjectId
    buyer       User?      @relation("boughtTenders", fields: [buyerId], references: [id], onDelete: Cascade)
    bids        Bid[]
    questions   Question[]
    createdAt   DateTime   @default(now())
    updatedAt   DateTime   @updatedAt
}

model Notification {
    id        String   @id @default(auto()) @map("_id") @db.ObjectId
    body      String
    type      String?  // bid_received | bid_accepted | bid_rejected | tender_reviewed | tender_closed | tender_cancelled | question_asked | question_answered
    read      Boolean  @default(false)
    user      User     @relation(fields: [userId], references: [id])
    userId    String   @db.ObjectId
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

model Question {
    id        String   @id @default(auto()) @map("_id") @db.ObjectId
    text      String
    tender    Tender   @relation(fields: [tenderId], references: [id], onDelete: Cascade)
    tenderId  String   @db.ObjectId
    asker     User     @relation(fields: [userId], references: [id])
    userId    String   @db.ObjectId
    answers   Answer[]
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

model Answer {
    id         String   @id @default(auto()) @map("_id") @db.ObjectId
    text       String
    question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
    questionId String   @db.ObjectId
    owner      User     @relation(fields: [userId], references: [id])
    userId     String   @db.ObjectId
    createdAt  DateTime @default(now())
    updatedAt  DateTime @updatedAt
}
