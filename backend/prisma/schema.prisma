generator client {
  provider = "prisma-client-js"
  // binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// ── Enums ─────────────────────────────────────────────────────────────────────
// Member names are deliberately identical to the string values previously stored
// as free text, so existing documents and API payloads are unchanged.

enum UserRole {
  vendor
  company
  admin
}

enum TenderStatus {
  draft
  open
  closed
  awarded
  cancelled
}

enum BidStatus {
  pending
  accepted
  rejected
  withdrawn
}

enum NotificationType {
  bid_received
  bid_accepted
  bid_rejected
  tender_reviewed
  tender_closed
  tender_cancelled
  question_asked
  question_answered
}

// ── Models ────────────────────────────────────────────────────────────────────

model User {
  id               String         @id @default(auto()) @map("_id") @db.ObjectId
  name             String?
  email            String         @unique
  role             UserRole?      @default(vendor)
  bio              String?
  image            String?
  coverImage       String?
  profileImage     String?
  password         String
  document         String?
  boughtTenders    Tender[]       @relation("boughtTenders")
  ownedTenders     Tender[]       @relation("ownedTenders")
  evaluatedTenders Tender[]       @relation("evaluatedTenders")
  notifications    Notification[]
  questions        Question[]
  answers          Answer[]
  bidAsCompany     Bid[]          @relation("company")
  bidAsVendor      Bid[]          @relation("vendor")
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

model Bid {
  id         String    @id @default(auto()) @map("_id") @db.ObjectId
  tender     Tender    @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  company    User      @relation("company", fields: [companyId], references: [id], onDelete: Cascade)
  vendor     User      @relation("vendor", fields: [vendorId], references: [id], onDelete: Cascade)
  tenderId   String    @db.ObjectId
  companyId  String    @db.ObjectId
  vendorId   String    @db.ObjectId
  status     BidStatus
  amount     Float
  message    String? // vendor's proposal / cover letter
  vendorName String?
  location   String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([tenderId, status])
  @@index([vendorId, status])
}

model Tender {
  id          String        @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  description String?
  category    String
  // Renamed from `cost`, which described the field's type rather than its meaning.
  // @map keeps the stored field name as "cost", so existing documents are unchanged.
  minimumBid  Float         @map("cost")
  deadline    DateTime? // bid submission deadline
  status      TenderStatus? @default(draft)
  rating      Int? // admin quality score 1–5
  imageUrl    String?
  companyName String?
  companyId   String        @db.ObjectId
  owner       User          @relation("ownedTenders", fields: [companyId], references: [id], onDelete: Cascade)
  // SetNull, not Cascade: deleting the admin who reviewed a tender, or the vendor
  // who won it, must not delete the tender and everything beneath it.
  evaluatorId String?       @db.ObjectId
  evaluator   User?         @relation("evaluatedTenders", fields: [evaluatorId], references: [id], onDelete: SetNull)
  buyerId     String?       @db.ObjectId
  buyer       User?         @relation("boughtTenders", fields: [buyerId], references: [id], onDelete: SetNull)
  bids        Bid[]
  questions   Question[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status, category])
  @@index([status, deadline])
  @@index([companyId])
}

model Notification {
  id        String            @id @default(auto()) @map("_id") @db.ObjectId
  body      String
  type      NotificationType?
  read      Boolean           @default(false)
  user      User              @relation(fields: [userId], references: [id])
  userId    String            @db.ObjectId
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@index([userId, read])
}

model Question {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  text      String
  tender    Tender   @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  tenderId  String   @db.ObjectId
  asker     User     @relation(fields: [userId], references: [id])
  userId    String   @db.ObjectId
  answers   Answer[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenderId])
}

model Answer {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  text       String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  questionId String   @db.ObjectId
  owner      User     @relation(fields: [userId], references: [id])
  userId     String   @db.ObjectId
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([questionId])
}
